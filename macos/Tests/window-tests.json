{
  "about": "The tests that drive an app's window, which no run can launch on Symphony's host. A run's Window tests step runs, in the QA VM, each test whose script or covered path its change touches (lib/symphony_elixir/phase_steps/window_tests.ex, docs/configuration.md#phases). `run` is the line the Mac CI build runs from macos/ (.github/workflows/mac-checks.yml); `covers` are globs where ** spans folders. A test that does not pass on main in the QA VM is `off` there, with why, until it does.",
  "tests": [
    {
      "script": "macos/Tests/qa-scroll-test.py",
      "title": "QA driver's scrolling test",
      "run": "python3 -I Tests/qa-scroll-test.py",
      "covers": ["priv/qa_driver/**"]
    },
    {
      "script": "macos/Tests/qa-key-test.py",
      "title": "QA driver's key and click test",
      "run": "python3 -I Tests/qa-key-test.py",
      "covers": ["priv/qa_driver/**"]
    },
    {
      "script": "macos/Tests/qa-appearance-test.sh",
      "title": "QA appearance library test",
      "run": "sh Tests/qa-appearance-test.sh",
      "covers": ["priv/qa_driver/**"]
    },
    {
      "script": "macos/Tests/home-drag-test.py",
      "title": "Home's drag and drop, with the mouse",
      "run": "python3 -I Tests/home-drag-test.py",
      "covers": [
        "macos/Sources/SymphonyBar/HomeView.swift",
        "macos/Sources/SymphonyBarCore/HomeQueue.swift",
        "macos/Sources/SymphonyBarCore/HomeQueueDrag.swift",
        "macos/Sources/SymphonyBarCore/HomeQueueFixture.swift",
        "macos/Sources/SymphonyBarUI/DesignSystem/QueueRow.swift",
        "macos/Sources/SymphonyBarUI/DesignSystem/SlotCard.swift",
        "macos/Tests/Fixtures/director-app/home-queue-drag/**",
        "macos/Tests/Fixtures/director-app/home-queue-epics/**",
        "macos/Sources/SymphonyBarUI/DesignSystem/QueueEpicParts.swift",
        "macos/Sources/SymphonyBarUI/DesignSystem/DoneRow.swift",
        "macos/Sources/SymphonyBarUI/DesignSystem/EpicSlotCard.swift",
        "macos/Tests/Fixtures/director-app/home-queue-epic-slot/**",
        "macos/Sources/SymphonyBarUI/DesignSystem/TitleLink.swift",
        "macos/Sources/SymphonyBarUI/HomeRecentlyDone.swift",
        "macos/Tests/Fixtures/director-app/home-queue/**",
        "priv/qa_driver/**"
      ]
    }
  ]
}
